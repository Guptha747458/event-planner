{
  "name": "event-planner-ai",
  "version": "1.0.0",
  "description": "GenAI-Powered Event Planning Assistant with Google Gemini & Antigravity",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "dev": "concurrently -k --kill-others-on-fail \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "gemini",
    "ai",
    "event-planner",
    "antigravity"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5"
  }
}
